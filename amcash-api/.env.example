DB_URL=jdbc:postgresql://localhost:5432/amcash
DB_USER=postgres
DB_PASSWORD=postgres
PORT=8080

# Use o mesmo Client ID configurado em amcash-web/.env.local.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Troque por uma chave longa e aleatória fora do ambiente local.
JWT_SECRET=troque-esta-chave-local-por-uma-chave-segura
JWT_EXPIRATION=86400000

